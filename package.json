{
  "name": "portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check:types": "tsc --noEmit",
    "knip": "knip",
    "check": "pnpm check:types && pnpm lint && pnpm knip && pnpm build",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "gray-matter": "^4.0.3",
    "next": "^16.3.7",
    "next-intl": "^4.14.8",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.9",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "husky": "^9.1.7",
    "knip": "^6.38.0",
    "lint-staged": "^16.2.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css}": "biome check --write --no-errors-on-unmatched"
  }
}
