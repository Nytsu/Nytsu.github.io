{
  "name": "portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check:types": "tsc --noEmit",
    "knip": "knip",
    "check": "pnpm check:types && pnpm lint && pnpm knip && pnpm build",
    "prepare": "husky"
  },
  "dependencies": {
    "@google/model-viewer": "^4.4.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "gray-matter": "^4.0.3",
    "next": "^16.4.5",
    "next-intl": "^4.14.9",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20.19.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "husky": "^9.1.7",
    "knip": "^6.44.1",
    "lint-staged": "^16.2.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css}": "biome check --write --no-errors-on-unmatched"
  },
  "pnpm": {
    "overrides": {
      "source-map-js": "^1.2.2"
    }
  }
}
